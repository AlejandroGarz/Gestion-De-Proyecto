        "name": "function 1",
        "func": "const productos = msg.payload;\nconst chatId = msg.originalMessage.chat.id;  // ← viene en el mensaje original\n\nlet mensaje = \"📦 *Lista de Productos*\\n\\n\";\n\nproductos.forEach(p => {\n    mensaje += `*id Producto: ${p.id}*\\n`;\n    mensaje += `*${p.nombre}*\\n`;\n    mensaje += `💰 Precio: $${p.precio}\\n`;\n    mensaje += `📊 Stock: ${p.stock}\\n\\n`;\n});\n\nmensaje += '\\n\\nEscribe el id del producto que deseas comprar...';\n\nmsg.payload = {\n    chatId: chatId,\n    type: \"message\",\n    content: mensaje\n};\n\nreturn msg;",
