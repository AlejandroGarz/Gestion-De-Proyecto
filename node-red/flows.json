        "type": "function",
        "z": "afba464ad22e772a",
        "name": "function 3",
        "func": "let chatId = msg.payload.chatId;\nlet texto = msg.payload.content;\n\nlet estado = flow.get(\"estado_\" + chatId);\n\n\nif(estado === \"en_menu\"){\n    if(texto === \"1\") {\n        flow.set(\"estado_\" + chatId, \"listando_productos\");\n        flow.set(\"chatId_activo\", chatId);\n\n        return [msg, null];\n    }\n\n    if(texto === \"2\") {\n\n        msg.payload = {\n            chatId: chatId,\n            type: \"message\",\n            content: \"Mostrando órdenes...\"\n        };\n\n        return [null, msg];\n    }\n}\nreturn null;",
